+
+/* === Theme button + menu === */
+.btn-theme.active {
+  background: var(--accent);
+}
+
+.theme-menu {
+  position: fixed;
+  z-index: 300;
+  width: min(380px, calc(100vw - 16px));
+  max-height: calc(100vh - 96px);
+  overflow-y: auto;
+  padding: 0.75rem;
+  background: var(--white);
+  color: var(--black);
+  border: 3px solid var(--black);
+  box-shadow: 6px 6px 0 var(--shadow);
+  font-family: 'Twemoji Country Flags', 'Space Grotesk', sans-serif;
+}
+
+.theme-menu[hidden] {
+  display: none;
+}
+
+.theme-menu-head {
+  font-family: 'Archivo Black', sans-serif;
+  font-size: 0.85rem;
+  padding-bottom: 0.5rem;
+  margin-bottom: 0.5rem;
+  border-bottom: 2px solid var(--black);
+}
+
+.theme-menu-default {
+  margin-bottom: 0.5rem;
+}
+
+.theme-menu-cols {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0.75rem;
+}
+
+.theme-menu-label {
+  font-size: 0.62rem;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  color: var(--text-muted);
+  margin: 0 0 0.25rem;
+}
+
+.theme-item {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+  width: 100%;
+  padding: 0.3rem 0.4rem;
+  margin: 0 0 2px;
+  background: transparent;
+  color: inherit;
+  border: 2px solid transparent;
+  font: 700 0.72rem 'Space Grotesk', sans-serif;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  text-align: left;
+  cursor: pointer;
+}
+
+.theme-item:hover,
+.theme-item:focus-visible {
+  border-color: var(--black);
+  background: var(--bg);
+  outline: none;
+}
+
+.theme-item[aria-checked="true"] {
+  border-color: var(--black);
+  background: var(--accent);
+  color: var(--on-accent);
+}
+
+.theme-item-label {
+  flex: 1;
+  min-width: 0;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.theme-swatch {
+  flex: 0 0 auto;
+  width: 18px;
+  height: 18px;
+  border: 2px solid var(--sw-ink);
+  background: linear-gradient(90deg, var(--sw-paper) 50%, var(--sw-accent) 50%);
+  box-shadow: 0 0 0 1px var(--white);
+}
+
+@media (max-width: 520px) {
+  .theme-menu-cols {
+    grid-template-columns: 1fr;
+  }
+}
