-/* Deep accents (Catppuccin mauve, Tokyo Night Day blue) carry light header text, like the dark schemes. */
+/* Chelsea: club blue / white / gold / red (#034694, #DBA111, #EE242C, #6A7AB5). */
+[data-scheme="chelsea-light"] {
+  --ink: #0a1f4a; --paper: #ffffff; --bg: #f1f2f4; --text-muted: #4b5876; --sig-text-mix: 65%;
+  --accent: #034694; --on-accent: #ffffff;
+  --accent-red: #EE242C; --accent-orange: #e8711c; --accent-yellow: #DBA111; --accent-green: #2e9d4f;
